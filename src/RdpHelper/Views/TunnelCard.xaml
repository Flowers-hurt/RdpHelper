<UserControl
    x:Class="RdpHelper.Views.TunnelCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ui:CardExpander x:Name="Expander" Margin="0,0,0,4">
        <ui:CardExpander.Icon>
            <ui:SymbolIcon x:Name="HeaderIcon" Symbol="Globe24" />
        </ui:CardExpander.Icon>
        <ui:CardExpander.Header>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="NameText" Style="{StaticResource CardTitle}" />
                    <TextBlock x:Name="SummaryText" Style="{StaticResource CardDesc}" />
                </StackPanel>
                <Border
                    x:Name="StateBadge"
                    Grid.Column="1"
                    Margin="12,0,16,0"
                    Style="{StaticResource Badge}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse
                            x:Name="StateDot"
                            Width="7"
                            Height="7"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Fill="Gray" />
                        <TextBlock
                            x:Name="StateText"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="未下载" />
                    </StackPanel>
                </Border>
            </Grid>
        </ui:CardExpander.Header>

        <StackPanel Margin="40,4,0,4">
            <!--  组件管理  -->
            <TextBlock x:Name="PathText" Style="{StaticResource CardDesc}" />
            <WrapPanel Margin="0,8,0,0">
                <ui:Button
                    x:Name="DownloadButton"
                    Margin="0,0,8,8"
                    Click="Download_Click"
                    Content="下载组件"
                    Icon="{ui:SymbolIcon ArrowDownload24}" />
                <ui:Button
                    Margin="0,0,8,8"
                    Click="Import_Click"
                    Content="导入本地 exe"
                    Icon="{ui:SymbolIcon FolderOpen24}" />
                <ui:Button
                    x:Name="UninstallButton"
                    Margin="0,0,8,8"
                    Click="Uninstall_Click"
                    Content="删除组件"
                    Icon="{ui:SymbolIcon Delete24}" />
                <ui:Button
                    Margin="0,0,8,8"
                    Click="Homepage_Click"
                    Content="项目主页"
                    Icon="{ui:SymbolIcon Open24}" />
            </WrapPanel>
            <ProgressBar
                x:Name="DownloadProgress"
                Height="4"
                Margin="0,0,0,8"
                Maximum="1"
                Visibility="Collapsed" />

            <!--  ngrok token  -->
            <StackPanel x:Name="TokenPanel" Margin="0,0,0,8" Visibility="Collapsed">
                <TextBlock Style="{StaticResource CardTitle}" Text="Authtoken" />
                <TextBlock x:Name="TokenHint" Style="{StaticResource CardDesc}" />
                <WrapPanel Margin="0,6,0,0">
                    <ui:PasswordBox
                        x:Name="TokenBox"
                        Width="320"
                        Margin="0,0,8,0"
                        PlaceholderText="粘贴 Authtoken" />
                    <ui:Button
                        Click="SaveToken_Click"
                        Content="保存"
                        Icon="{ui:SymbolIcon Key24}" />
                    <TextBlock
                        x:Name="TokenState"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource CardDesc}" />
                </WrapPanel>
            </StackPanel>

            <!--  运行  -->
            <WrapPanel Margin="0,4,0,0">
                <ComboBox
                    x:Name="TargetBox"
                    Width="150"
                    Margin="0,0,8,8"
                    SelectedIndex="0">
                    <ComboBoxItem Content="远程桌面 (RDP)" />
                    <ComboBoxItem Content="SSH" />
                </ComboBox>
                <ui:Button
                    x:Name="StartButton"
                    Margin="0,0,8,8"
                    Appearance="Primary"
                    Click="Start_Click"
                    Content="启动穿透"
                    Icon="{ui:SymbolIcon Play24}" />
                <ui:Button
                    x:Name="StopButton"
                    Margin="0,0,8,8"
                    Click="Stop_Click"
                    Content="停止"
                    Icon="{ui:SymbolIcon Stop24}" />
                <ui:ProgressRing
                    x:Name="StartBusy"
                    Width="18"
                    Height="18"
                    Margin="4,0,0,8"
                    IsIndeterminate="True"
                    Visibility="Collapsed" />
            </WrapPanel>

            <Border
                x:Name="AddressPanel"
                Margin="0,0,0,8"
                Padding="12"
                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                CornerRadius="6"
                Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardDesc}" Text="公网地址" />
                        <TextBox
                            x:Name="AddressText"
                            Background="Transparent"
                            BorderThickness="0"
                            FontFamily="Consolas, Cascadia Mono"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            IsReadOnly="True" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <ui:Button
                            Margin="0,0,8,0"
                            Click="CopyAddress_Click"
                            Content="复制地址"
                            Icon="{ui:SymbolIcon Copy24}" />
                        <ui:Button
                            Appearance="Primary"
                            Click="CopyAll_Click"
                            Content="复制完整连接信息"
                            Icon="{ui:SymbolIcon Share24}" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock
                x:Name="NotesText"
                Margin="0,0,0,8"
                Style="{StaticResource CardDesc}" />

            <Expander Header="运行日志">
                <TextBox
                    x:Name="LogBox"
                    Height="160"
                    Margin="0,6,0,0"
                    FontFamily="Consolas, Cascadia Mono"
                    FontSize="11"
                    HorizontalScrollBarVisibility="Auto"
                    IsReadOnly="True"
                    TextWrapping="NoWrap"
                    VerticalScrollBarVisibility="Auto" />
            </Expander>
        </StackPanel>
    </ui:CardExpander>
</UserControl>
