<Page
    x:Class="RdpHelper.Views.AccountsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:l="clr-namespace:RdpHelper.Localization"
    Title="{l:T '账户与密码'}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,4,40,40" MaxWidth="1000">
            <TextBlock Style="{StaticResource PageTitle}" Text="{l:T '账户与密码'}" />

            <ui:InfoBar
                Title="{l:T '远程桌面和 SSH 都用 Windows 账户登录'}"
                Margin="0,0,0,4"
                IsClosable="True"
                IsOpen="True"
                Message="{l:T '这是 Windows 的机制，没有单独的「远程密码」。可以给当前账户设置密码、创建一个独立的远程专用账户，或让 SSH 改用密钥免密码登录。'}"
                Severity="Informational" />

            <!--  当前账户状态  -->
            <Border
                Margin="0,8,0,0"
                Padding="20"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="64"
                        Height="64"
                        Margin="0,0,20,0"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="32">
                        <ui:SymbolIcon FontSize="34" Symbol="Person24" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                x:Name="UserText"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Border Style="{StaticResource Badge}">
                                <TextBlock
                                    x:Name="KindText"
                                    FontSize="11"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Border>
                            <Border x:Name="AdminBadge" Style="{StaticResource Badge}">
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{l:T '管理员'}" />
                            </Border>
                        </StackPanel>
                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                            <Ellipse
                                x:Name="StatusDot"
                                Width="8"
                                Height="8"
                                Margin="0,0,8,0"
                                Fill="Gray" />
                            <TextBlock
                                x:Name="StatusText"
                                FontSize="13"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{l:T '正在读取状态…'}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
            <ui:InfoBar
                x:Name="PasswordlessBar"
                Title="{l:T '已开启「仅允许 Windows Hello 登录」'}"
                Margin="0,8,0,0"
                IsClosable="False"
                IsOpen="False"
                Message="{l:T '开启时远程桌面输入账户密码会失败。请在「设置 → 账户 → 登录选项」里关闭「为了提高安全性，仅允许 Windows Hello 登录」，并用密码在本机登录一次。'}"
                Severity="Warning" />

            <!--  当前账户密码  -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="{l:T '当前账户密码'}" />
            <ui:CardExpander
                x:Name="LocalPasswordCard"
                Margin="0,0,0,4"
                Icon="{ui:SymbolIcon Password24}"
                IsExpanded="True">
                <ui:CardExpander.Header>
                    <StackPanel>
                        <TextBlock x:Name="PasswordCardTitle" Style="{StaticResource CardTitle}" Text="{l:T '设置登录密码'}" />
                        <TextBlock Style="{StaticResource CardDesc}" Text="{l:T '这也是开机、锁屏使用的密码。设置后用 Windows 账户名和这个密码远程登录。'}" />
                    </StackPanel>
                </ui:CardExpander.Header>
                <StackPanel Margin="40,4,0,4">
                    <WrapPanel>
                        <ui:PasswordBox
                            x:Name="NewPasswordBox"
                            Width="220"
                            Margin="0,0,8,8"
                            PlaceholderText="{l:T '新密码'}" />
                        <ui:PasswordBox
                            x:Name="ConfirmPasswordBox"
                            Width="220"
                            Margin="0,0,8,8"
                            PlaceholderText="{l:T '再输入一次'}" />
                        <ui:Button
                            Margin="0,0,8,8"
                            Appearance="Primary"
                            Click="SetPassword_Click"
                            Content="{l:T '保存密码'}"
                            Icon="{ui:SymbolIcon Checkmark24}" />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource CardDesc}" Text="{l:T '请牢记新密码：忘记后只能用其它管理员账户重置。'}" />
                </StackPanel>
            </ui:CardExpander>
            <ui:CardControl
                x:Name="MicrosoftPasswordCard"
                Margin="0,0,0,4"
                Icon="{ui:SymbolIcon Globe24}"
                Visibility="Collapsed">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T '微软账户：用邮箱和微软账户密码远程登录'}" />
                        <TextBlock Style="{StaticResource CardDesc}" Text="{l:T 'PIN 码和指纹不能用于远程登录。微软账户密码只能在微软网站修改；不想用它，可以在下面创建远程专用账户。'}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:Button
                        Margin="0,0,8,0"
                        Click="MsPassword_Click"
                        Content="{l:T '修改微软账户密码'}"
                        Icon="{ui:SymbolIcon Open24}" />
                    <ui:Button
                        Click="SignInOptions_Click"
                        Content="{l:T '登录选项'}"
                        Icon="{ui:SymbolIcon Settings24}" />
                </StackPanel>
            </ui:CardControl>

            <!--  远程专用账户  -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="{l:T '远程专用账户'}" />
            <ui:CardExpander Margin="0,0,0,4" Icon="{ui:SymbolIcon PersonAdd24}">
                <ui:CardExpander.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T '新建远程专用账户'}" />
                        <TextBlock Style="{StaticResource CardDesc}" Text="{l:T '用户名和密码都由你决定，只给别人远程用，不影响你自己的账户；用完可随时禁用或删除。'}" />
                    </StackPanel>
                </ui:CardExpander.Header>
                <StackPanel Margin="40,4,0,4">
                    <WrapPanel>
                        <ui:TextBox
                            x:Name="NewUserBox"
                            Width="180"
                            Margin="0,0,8,8"
                            MaxLength="20"
                            PlaceholderText="{l:T '用户名，如 remote'}" />
                        <ui:PasswordBox
                            x:Name="NewUserPasswordBox"
                            Width="180"
                            Margin="0,0,8,8"
                            PlaceholderText="{l:T '密码'}" />
                        <ui:PasswordBox
                            x:Name="NewUserConfirmBox"
                            Width="180"
                            Margin="0,0,8,8"
                            PlaceholderText="{l:T '再输入一次'}" />
                    </WrapPanel>
                    <CheckBox
                        x:Name="NewUserAdminBox"
                        Margin="0,0,0,8"
                        Content="{l:T '授予管理员权限（不推荐：对方可以修改系统设置）'}" />
                    <WrapPanel>
                        <ui:Button
                            Margin="0,0,8,8"
                            Appearance="Primary"
                            Click="CreateUser_Click"
                            Content="{l:T '创建账户'}"
                            Icon="{ui:SymbolIcon PersonAdd24}" />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource CardDesc}" Text="{l:T '账户会自动加入「远程桌面用户」组，也可用于 SSH。注意：家庭 / 专业版 Windows 同一时间只允许一个人登录，对方用这个账户连进来时，你本人当前的会话会被断开（程序不会关闭），对方看到的是这个账户自己的桌面。'}" />
                </StackPanel>
            </ui:CardExpander>
            <ItemsControl x:Name="RemoteAccountList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Person24}">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            FontFamily="Consolas, Cascadia Mono, Segoe UI"
                                            FontSize="15"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Text="{Binding Name}" />
                                        <Border Style="{StaticResource Badge}">
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{Binding StateText}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource CardDesc}" Text="{Binding Detail}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <WrapPanel>
                                <ui:Button
                                    Margin="0,0,8,0"
                                    Click="CopyLogin_Click"
                                    Content="{Binding CopyLabel}"
                                    Icon="{ui:SymbolIcon Copy24}"
                                    Tag="{Binding Name}" />
                                <ui:Button
                                    Margin="0,0,8,0"
                                    Click="ResetPassword_Click"
                                    Content="{Binding ResetLabel}"
                                    Icon="{ui:SymbolIcon Key24}"
                                    Tag="{Binding Name}" />
                                <ui:Button
                                    Margin="0,0,8,0"
                                    Click="ToggleUser_Click"
                                    Content="{Binding ToggleLabel}"
                                    Icon="{ui:SymbolIcon Power24}"
                                    Tag="{Binding Name}" />
                                <ui:Button
                                    Click="DeleteUser_Click"
                                    Content="{Binding DeleteLabel}"
                                    Icon="{ui:SymbolIcon Delete24}"
                                    Tag="{Binding Name}" />
                            </WrapPanel>
                        </ui:CardControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock
                x:Name="NoRemoteAccountText"
                Margin="2,4,0,0"
                Style="{StaticResource CardDesc}"
                Text="{l:T '还没有远程专用账户。'}" />

            <!--  SSH 密钥  -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="{l:T 'SSH 密钥登录（免密码）'}" />
            <ui:InfoBar
                x:Name="SshMissingBar"
                Title="{l:T '尚未安装 OpenSSH 服务器'}"
                Margin="0,0,0,4"
                IsClosable="False"
                IsOpen="False"
                Message="{l:T '请先在「SSH」页一键安装，然后再配置密钥。'}"
                Severity="Warning" />
            <ui:CardExpander
                x:Name="KeyCard"
                Margin="0,0,0,4"
                Icon="{ui:SymbolIcon Key24}"
                IsExpanded="True">
                <ui:CardExpander.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T '允许以下公钥免密码登录当前账户'}" />
                        <TextBlock x:Name="KeyFileText" Style="{StaticResource CardDesc}" />
                    </StackPanel>
                </ui:CardExpander.Header>
                <StackPanel Margin="40,4,0,4">
                    <TextBlock Style="{StaticResource CardDesc}" Text="{l:T '对方在自己电脑上运行下面的命令生成密钥（一路回车即可），再把 id_ed25519.pub 文件的内容发给你，粘贴到这里：'}" />
                    <Grid Margin="0,6,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Padding="10,6"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="4">
                            <TextBlock
                                FontFamily="Consolas, Cascadia Mono"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="ssh-keygen -t ed25519   →   type %USERPROFILE%\.ssh\id_ed25519.pub   /   cat ~/.ssh/id_ed25519.pub" />
                        </Border>
                        <ui:Button
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            Click="CopyKeygen_Click"
                            Content="{l:T '复制命令'}"
                            Icon="{ui:SymbolIcon Copy24}" />
                    </Grid>
                    <ui:TextBox
                        x:Name="KeyInputBox"
                        MinHeight="72"
                        AcceptsReturn="True"
                        FontFamily="Consolas, Cascadia Mono"
                        FontSize="12"
                        PlaceholderText="ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAA… user@laptop"
                        TextWrapping="Wrap" />
                    <WrapPanel Margin="0,8,0,8">
                        <ui:Button
                            Appearance="Primary"
                            Click="AddKey_Click"
                            Content="{l:T '添加公钥'}"
                            Icon="{ui:SymbolIcon Add24}" />
                    </WrapPanel>
                    <ItemsControl x:Name="KeyList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon
                                        Margin="0,0,12,0"
                                        FontSize="18"
                                        Symbol="Key24" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Display}" />
                                        <TextBlock
                                            FontFamily="Consolas, Cascadia Mono"
                                            Style="{StaticResource CardDesc}"
                                            Text="{Binding Fingerprint}" />
                                    </StackPanel>
                                    <ui:Button
                                        Grid.Column="2"
                                        Click="RemoveKey_Click"
                                        Icon="{ui:SymbolIcon Delete24}"
                                        Tag="{Binding Fingerprint}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="NoKeyText" Style="{StaticResource CardDesc}" Text="{l:T '还没有添加公钥。'}" />
                </StackPanel>
            </ui:CardExpander>
            <ui:CardControl
                x:Name="PasswordAuthCard"
                Margin="0,0,0,4"
                Icon="{ui:SymbolIcon ShieldLock24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T '允许 SSH 使用密码登录'}" />
                        <TextBlock Style="{StaticResource CardDesc}" Text="{l:T '关闭后只能用上面的公钥登录，可防止密码被暴力破解（公网穿透时推荐关闭）。修改后会重启 sshd。'}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch
                    x:Name="PasswordAuthToggle"
                    Click="PasswordAuth_Click"
                    OffContent="{l:T '关'}"
                    OnContent="{l:T '开'}" />
            </ui:CardControl>

            <ui:ProgressRing
                x:Name="Busy"
                Width="24"
                Height="24"
                Margin="0,16,0,0"
                HorizontalAlignment="Left"
                IsIndeterminate="True"
                Visibility="Collapsed" />
        </StackPanel>
    </ScrollViewer>
</Page>
