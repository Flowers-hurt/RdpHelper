<Page
    x:Class="RdpHelper.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:l="clr-namespace:RdpHelper.Localization"
    Title="{l:T '关于'}">
    <Page.Resources>
        <Style x:Key="Pill" TargetType="Border">
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="PillText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
    </Page.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,4,40,40" MaxWidth="1000">
            <TextBlock Style="{StaticResource PageTitle}" Text="{l:T '关于'}" />

            <!--  顶部大卡片：图标 + 名称 + 版本 + 主要操作  -->
            <Border
                Padding="28,24"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#330078D4" />
                        <GradientStop Offset="0.55" Color="#110078D4" />
                        <GradientStop Offset="1" Color="#22B146C2" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image
                        Width="96"
                        Height="96"
                        Margin="0,0,24,0"
                        VerticalAlignment="Top"
                        Source="pack://application:,,,/Assets/app.png" />
                    <StackPanel Grid.Column="1">
                        <TextBlock
                            FontSize="30"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="RdpHelper" />
                        <TextBlock
                            Margin="0,4,0,12"
                            FontSize="14"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{l:T '一键开启 Windows 远程桌面 / OpenSSH · 自定义端口 · IP 黑白名单 · 按需内网穿透'}"
                            TextWrapping="Wrap" />
                        <WrapPanel>
                            <Border Style="{StaticResource Pill}">
                                <TextBlock x:Name="VersionPill" Style="{StaticResource PillText}" />
                            </Border>
                            <Border Style="{StaticResource Pill}">
                                <TextBlock Style="{StaticResource PillText}" Text="MIT License" />
                            </Border>
                            <Border Style="{StaticResource Pill}">
                                <TextBlock Style="{StaticResource PillText}" Text=".NET 8 · WPF-UI" />
                            </Border>
                            <Border Style="{StaticResource Pill}">
                                <TextBlock x:Name="ArchPill" Style="{StaticResource PillText}" />
                            </Border>
                            <Border x:Name="StatsPill" Style="{StaticResource Pill}" Visibility="Collapsed">
                                <TextBlock x:Name="StatsText" Style="{StaticResource PillText}" />
                            </Border>
                        </WrapPanel>
                        <WrapPanel Margin="0,8,0,0">
                            <ui:Button
                                Margin="0,0,8,8"
                                Appearance="Primary"
                                Click="Repo_Click"
                                Content="{l:T 'GitHub 仓库'}"
                                Icon="{ui:SymbolIcon Open24}" />
                            <ui:Button
                                x:Name="UpdateButton"
                                Margin="0,0,8,8"
                                Click="CheckUpdate_Click"
                                Content="{l:T '检查更新'}"
                                Icon="{ui:SymbolIcon ArrowSync24}" />
                            <ui:Button
                                Margin="0,0,8,8"
                                Click="Releases_Click"
                                Content="{l:T '更新日志'}"
                                Icon="{ui:SymbolIcon History24}" />
                            <ui:ProgressRing
                                x:Name="UpdateBusy"
                                Width="18"
                                Height="18"
                                Margin="4,0,0,8"
                                IsIndeterminate="True"
                                Visibility="Collapsed" />
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <ui:InfoBar
                x:Name="UpdateBar"
                Margin="0,12,0,0"
                IsClosable="True"
                IsOpen="False" />
            <ui:Button
                x:Name="DownloadUpdateButton"
                Margin="0,8,0,0"
                Appearance="Primary"
                Click="DownloadUpdate_Click"
                Content="{l:T '前往下载新版本'}"
                Icon="{ui:SymbolIcon ArrowDownload24}"
                Visibility="Collapsed" />

            <!--  作者  -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="{l:T '作者'}" />
            <ui:CardControl Margin="0,0,0,4">
                <ui:CardControl.Header>
                    <StackPanel Orientation="Horizontal">
                        <Grid
                            Width="44"
                            Height="44"
                            Margin="0,0,14,0">
                            <Ellipse Fill="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="F" />
                            <Ellipse x:Name="AuthorAvatar" />
                        </Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource CardTitle}" Text="Flowers-hurt" />
                            <TextBlock Style="{StaticResource CardDesc}" Text="{l:T '作者 · 维护者'}" />
                        </StackPanel>
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button
                    Click="Author_Click"
                    Content="{l:T 'GitHub 主页'}"
                    Icon="{ui:SymbolIcon Person24}" />
            </ui:CardControl>

            <!--  参与贡献  -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="{l:T '参与贡献'}" />
            <TextBlock
                Margin="2,0,0,8"
                Style="{StaticResource CardDesc}"
                Text="{l:T 'RdpHelper 是完全开源的项目，欢迎任何形式的贡献：报告问题、提出建议、改进代码或翻译。'}" />
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Bug24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T '报告问题'}" />
                        <TextBlock Style="{StaticResource CardDesc}" Text="{l:T '遇到 Bug？请附上 Windows 版本、复现步骤和截图，「复制诊断信息」可一键带上版本信息'}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:Button
                        Margin="0,0,8,0"
                        Click="CopyDiag_Click"
                        Content="{l:T '复制诊断信息'}"
                        Icon="{ui:SymbolIcon Copy24}" />
                    <ui:Button
                        Click="Bug_Click"
                        Content="{l:T '提交 Issue'}"
                        Icon="{ui:SymbolIcon Open24}" />
                </StackPanel>
            </ui:CardControl>
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Lightbulb24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T '功能建议'}" />
                        <TextBlock Style="{StaticResource CardDesc}" Text="{l:T '想要新的穿透服务商、新功能或界面改进？告诉我们你的使用场景'}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button
                    Click="Feature_Click"
                    Content="{l:T '提出建议'}"
                    Icon="{ui:SymbolIcon Open24}" />
            </ui:CardControl>
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Code24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T '贡献代码'}" />
                        <TextBlock Style="{StaticResource CardDesc}" Text="{l:T 'Fork 仓库 → 新建分支 → 提交 Pull Request；CI 会在真实 Windows 上自动跑完整自检'}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button
                    Click="Contributing_Click"
                    Content="{l:T '贡献指南'}"
                    Icon="{ui:SymbolIcon Open24}" />
            </ui:CardControl>
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon LocalLanguage24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T '帮助翻译'}" />
                        <TextBlock Style="{StaticResource CardDesc}" Text="{l:T '界面文案集中在 Localization/en.json，欢迎改进英文或增加新语言'}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button
                    Click="Translate_Click"
                    Content="{l:T '查看文件'}"
                    Icon="{ui:SymbolIcon Open24}" />
            </ui:CardControl>
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Star24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T '给项目点个 Star'}" />
                        <TextBlock Style="{StaticResource CardDesc}" Text="{l:T '如果 RdpHelper 帮到了你，一个 Star 就是对作者最大的鼓励'}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button
                    Appearance="Primary"
                    Click="Repo_Click"
                    Content="Star ⭐"
                    Icon="{ui:SymbolIcon Star24}" />
            </ui:CardControl>

            <!--  贡献者  -->
            <Grid Margin="0,24,0,8">
                <TextBlock
                    Margin="2,0,0,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource CardTitle}"
                    FontWeight="SemiBold"
                    Text="{l:T '贡献者'}" />
                <ui:HyperlinkButton
                    Padding="6,2"
                    HorizontalAlignment="Right"
                    Click="Contributors_Click"
                    Content="{l:T '查看全部'}" />
            </Grid>
            <Border
                Padding="16"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel>
                    <ItemsControl x:Name="ContributorList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button
                                    Width="88"
                                    Margin="0,0,8,8"
                                    Padding="4,8"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="Contributor_Click"
                                    Cursor="Hand"
                                    Tag="{Binding ProfileUrl}"
                                    ToolTip="{Binding Tooltip}">
                                    <StackPanel>
                                        <Ellipse Width="52" Height="52">
                                            <Ellipse.Fill>
                                                <ImageBrush ImageSource="{Binding Image}" />
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <TextBlock
                                            Margin="0,6,0,0"
                                            HorizontalAlignment="Center"
                                            FontSize="12"
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Text="{Binding Login}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="ContributorState" Style="{StaticResource CardDesc}" />
                </StackPanel>
            </Border>

            <!--  开源许可  -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="{l:T '开源许可'}" />
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Certificate24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'RdpHelper 采用 MIT 许可证'}" />
                        <TextBlock Style="{StaticResource CardDesc}" Text="{l:T '可自由使用、修改和分发，包括商业用途；请保留版权声明'}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button
                    Click="License_Click"
                    Content="{l:T '查看许可证'}"
                    Icon="{ui:SymbolIcon Document24}" />
            </ui:CardControl>
            <ui:CardExpander Margin="0,0,0,4" Icon="{ui:SymbolIcon Box24}">
                <ui:CardExpander.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T '第三方开源组件'}" />
                        <TextBlock x:Name="ThirdPartySummary" Style="{StaticResource CardDesc}" />
                    </StackPanel>
                </ui:CardExpander.Header>
                <ItemsControl x:Name="ThirdPartyList" Margin="40,0,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitle}">
                                        <Run Text="{Binding Name, Mode=OneWay}" />
                                        <Run
                                            FontSize="12"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="{Binding License, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource CardDesc}" Text="{Binding Usage}" />
                                </StackPanel>
                                <ui:HyperlinkButton
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Click="ThirdParty_Click"
                                    Content="{Binding Host}"
                                    Tag="{Binding Url}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ui:CardExpander>

            <!--  页脚  -->
            <StackPanel Margin="0,28,0,0" HorizontalAlignment="Center">
                <TextBlock
                    x:Name="CopyrightText"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock
                    Margin="0,4,0,0"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Text="{l:T '用 ❤ 和 .NET 构建 · 感谢所有开源项目'}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
