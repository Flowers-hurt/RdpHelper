<Page
    x:Class="RdpHelper.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="设置">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,4,40,40" MaxWidth="1000">
            <TextBlock Style="{StaticResource PageTitle}" Text="设置" />

            <TextBlock Style="{StaticResource SectionHeader}" Text="外观" />
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon DarkTheme24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="主题" />
                        <TextBlock Style="{StaticResource CardDesc}" Text="跟随系统时，切换 Windows 深浅色会自动同步" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox
                    x:Name="ThemeBox"
                    Width="180"
                    SelectionChanged="Appearance_Changed">
                    <ComboBoxItem Content="跟随系统" Tag="system" />
                    <ComboBoxItem Content="浅色" Tag="light" />
                    <ComboBoxItem Content="深色" Tag="dark" />
                </ComboBox>
            </ui:CardControl>
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Blur24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="窗口材质" />
                        <TextBlock Style="{StaticResource CardDesc}" Text="亚克力 = 毛玻璃，透出并模糊窗口背后的内容；云母只取桌面壁纸的颜色。需要 Windows 11 22H2 及以上" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox
                    x:Name="BackdropBox"
                    Width="180"
                    SelectionChanged="Appearance_Changed">
                    <ComboBoxItem Content="亚克力（毛玻璃）" Tag="acrylic" />
                    <ComboBoxItem Content="云母 Mica" Tag="mica" />
                    <ComboBoxItem Content="云母 Alt" Tag="tabbed" />
                    <ComboBoxItem Content="无" Tag="none" />
                </ComboBox>
            </ui:CardControl>

            <TextBlock Style="{StaticResource SectionHeader}" Text="数据" />
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Folder24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="穿透组件目录" />
                        <TextBlock x:Name="ToolsPathText" Style="{StaticResource CardDesc}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button
                    Click="OpenTools_Click"
                    Content="打开"
                    Icon="{ui:SymbolIcon FolderOpen24}" />
            </ui:CardControl>
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Document24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="配置文件（黑白名单等）" />
                        <TextBlock x:Name="SettingsPathText" Style="{StaticResource CardDesc}" />
                    </StackPanel>
                </ui:CardControl.Header>
            </ui:CardControl>

            <TextBlock Style="{StaticResource SectionHeader}" Text="关于" />
            <ui:CardControl Margin="0,0,0,4">
                <ui:CardControl.Icon>
                    <ui:ImageIcon
                        Width="24"
                        Height="24"
                        Source="pack://application:,,,/Assets/app.png" />
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="RdpHelper 远程桌面助手" />
                        <TextBlock x:Name="VersionText" Style="{StaticResource CardDesc}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button
                    Click="Github_Click"
                    Content="GitHub"
                    Icon="{ui:SymbolIcon Open24}" />
            </ui:CardControl>
        </StackPanel>
    </ScrollViewer>
</Page>
