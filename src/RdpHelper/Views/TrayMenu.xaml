<Window
    x:Class="RdpHelper.Views.TrayMenu"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:l="clr-namespace:RdpHelper.Localization"
    Title="RdpHelper"
    Width="300"
    ResizeMode="NoResize"
    ShowActivated="True"
    ShowInTaskbar="False"
    SizeToContent="Height"
    Topmost="True"
    UseLayoutRounding="True"
    WindowStartupLocation="Manual"
    WindowStyle="None">
    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="0"
            CornerRadius="0"
            GlassFrameThickness="-1"
            ResizeBorderThickness="0"
            UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Win11 菜单项：圆角 4、悬停浅色填充，和主界面 WPF-UI 控件一致 -->
        <Style x:Key="MenuRow" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="4,1" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RowIcon" TargetType="ui:SymbolIcon">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="StatusName" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="StatusValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </Window.Resources>

    <Border x:Name="Root" BorderThickness="0">
        <StackPanel Margin="0,4,0,4">
            <!-- 头部：图标 + 名称 + 版本 -->
            <Grid Margin="16,10,16,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image
                    Width="32"
                    Height="32"
                    Source="pack://application:,,,/Assets/app.png" />
                <StackPanel
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center">
                    <TextBlock
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="RdpHelper" />
                    <TextBlock
                        x:Name="SubtitleText"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>

            <!-- 状态卡片：远程桌面 / SSH / 内网穿透 -->
            <Border
                Margin="8,0,8,6"
                Padding="12,8"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <Grid x:Name="StatusGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="24" />
                        <RowDefinition Height="24" />
                        <RowDefinition Height="24" />
                    </Grid.RowDefinitions>
                    <Ellipse x:Name="RdpDot" Width="8" Height="8" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="1" Style="{StaticResource StatusName}" Text="{l:T '远程桌面'}" />
                    <TextBlock x:Name="RdpText" Grid.Column="2" Margin="12,0,0,0" Style="{StaticResource StatusValue}" />

                    <Ellipse x:Name="SshDot" Grid.Row="1" Width="8" Height="8" Margin="0,0,10,0" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource StatusName}" Text="SSH" />
                    <TextBlock x:Name="SshText" Grid.Row="1" Grid.Column="2" Margin="12,0,0,0" Style="{StaticResource StatusValue}" />

                    <Ellipse x:Name="TunnelDot" Grid.Row="2" Width="8" Height="8" Margin="0,0,10,0" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource StatusName}" Text="{l:T '内网穿透'}" />
                    <TextBlock x:Name="TunnelText" Grid.Row="2" Grid.Column="2" Margin="12,0,0,0" Style="{StaticResource StatusValue}" />
                </Grid>
            </Border>

            <Button x:Name="OpenRow" Click="Open_Click" Style="{StaticResource MenuRow}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Style="{StaticResource RowIcon}" Symbol="Open24" />
                    <TextBlock FontSize="14" Text="{l:T '打开主界面'}" />
                </StackPanel>
            </Button>
            <Button x:Name="CopyRow" Click="Copy_Click" Style="{StaticResource MenuRow}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon x:Name="CopyIcon" Style="{StaticResource RowIcon}" Symbol="Copy24" />
                    <TextBlock x:Name="CopyText" FontSize="14" Text="{l:T '复制远程连接信息'}" />
                </StackPanel>
            </Button>
            <Button Click="Settings_Click" Style="{StaticResource MenuRow}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Style="{StaticResource RowIcon}" Symbol="Settings24" />
                    <TextBlock FontSize="14" Text="{l:T '设置'}" />
                </StackPanel>
            </Button>

            <Border
                Height="1"
                Margin="0,4"
                Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

            <Button Click="Exit_Click" Style="{StaticResource MenuRow}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Style="{StaticResource RowIcon}" Symbol="Power24" />
                    <TextBlock FontSize="14" Text="{l:T '退出 RdpHelper'}" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</Window>
