<Page
    x:Class="RdpHelper.Views.SshPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:l="clr-namespace:RdpHelper.Localization"
    Title="SSH">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,4,40,40" MaxWidth="1000">
            <TextBlock Style="{StaticResource PageTitle}" Text="SSH" />
            <ui:InfoBar
                x:Name="PasswordBar"
                Margin="0,0,0,4"
                IsClosable="False"
                IsOpen="False"
                Severity="Warning" />
            <ui:Button
                x:Name="PasswordFixButton"
                Margin="0,0,0,12"
                Appearance="Primary"
                Click="GoAccounts_Click"
                Content="{l:T '去「账户与密码」处理'}"
                Icon="{ui:SymbolIcon Person24}"
                Visibility="Collapsed" />

            <Border
                Padding="20"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="72"
                        Height="72"
                        Margin="0,0,20,0"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="16">
                        <ui:SymbolIcon FontSize="40" Symbol="WindowConsole20" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="{l:T 'OpenSSH 服务器'}" />
                        <TextBlock Style="{StaticResource CardDesc}" Text="{l:T 'Windows 内置的 SSH 服务端，可用命令行远程管理这台电脑，也支持 SFTP / scp 传文件、端口转发。'}" />
                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                            <Ellipse
                                x:Name="StatusDot"
                                Width="8"
                                Height="8"
                                Margin="0,0,8,0"
                                Fill="Gray" />
                            <TextBlock
                                x:Name="StatusText"
                                FontSize="13"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{l:T '正在读取状态…'}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Style="{StaticResource SectionHeader}" Text="{l:T '服务'}" />

            <ui:CardControl
                x:Name="InstallCard"
                Margin="0,0,0,4"
                Icon="{ui:SymbolIcon ArrowDownload24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T '安装 OpenSSH 服务器'}" />
                        <TextBlock
                            x:Name="InstallDesc"
                            Style="{StaticResource CardDesc}"
                            Text="{l:T '使用安装包自带的微软官方 Win32-OpenSSH，离线即可安装；失败时改用 Windows「可选功能」或在线下载。'}" />
                        <ProgressBar
                            x:Name="InstallProgress"
                            Height="4"
                            Margin="0,8,0,0"
                            Maximum="1"
                            Visibility="Collapsed" />
                        <Expander
                            x:Name="InstallLogExpander"
                            Margin="0,6,0,0"
                            Header="{l:T '安装日志'}"
                            Visibility="Collapsed">
                            <TextBox
                                x:Name="InstallLog"
                                Height="140"
                                Margin="0,6,0,0"
                                FontFamily="Consolas, Cascadia Mono"
                                FontSize="11"
                                HorizontalScrollBarVisibility="Auto"
                                IsReadOnly="True"
                                TextWrapping="NoWrap"
                                VerticalScrollBarVisibility="Auto" />
                        </Expander>
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:ProgressRing
                        x:Name="InstallBusy"
                        Width="18"
                        Height="18"
                        Margin="0,0,12,0"
                        IsIndeterminate="True"
                        Visibility="Collapsed" />
                    <ui:Button
                        x:Name="InstallButton"
                        Appearance="Primary"
                        Click="Install_Click"
                        Content="{l:T '一键安装'}"
                        Icon="{ui:SymbolIcon ArrowDownload24}" />
                </StackPanel>
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon WindowConsole20}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'SSH 服务'}" />
                        <TextBlock Style="{StaticResource CardDesc}" Text="{l:T '开启后 sshd 设为开机自启，并按「访问控制」中的名单放行防火墙'}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:ProgressRing
                        x:Name="SshBusy"
                        Width="18"
                        Height="18"
                        Margin="0,0,12,0"
                        IsIndeterminate="True"
                        Visibility="Collapsed" />
                    <ui:ToggleSwitch
                        x:Name="SshToggle"
                        Click="SshToggle_Click"
                        OffContent="{l:T '关'}"
                        OnContent="{l:T '开'}" />
                </StackPanel>
            </ui:CardControl>

            <ui:CardExpander Margin="0,0,0,4" Icon="{ui:SymbolIcon NumberSymbol24}" IsExpanded="True">
                <ui:CardExpander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'SSH 端口'}" />
                            <TextBlock Style="{StaticResource CardDesc}" Text="{l:T '默认 22；修改 sshd_config 的 Port 并重启 sshd'}" />
                        </StackPanel>
                        <TextBlock
                            x:Name="PortText"
                            Grid.Column="1"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="22" />
                    </Grid>
                </ui:CardExpander.Header>
                <StackPanel Margin="40,4,0,4">
                    <WrapPanel>
                        <ui:TextBox
                            x:Name="PortBox"
                            Width="160"
                            Margin="0,0,8,8"
                            MaxLength="5"
                            PlaceholderText="1024-65535" />
                        <ui:Button
                            Margin="0,0,8,8"
                            Appearance="Primary"
                            Click="ApplyPort_Click"
                            Content="{l:T '应用新端口'}"
                            Icon="{ui:SymbolIcon Checkmark24}" />
                        <ui:Button
                            Margin="0,0,8,8"
                            Click="RandomPort_Click"
                            Content="{l:T '随机生成'}"
                            Icon="{ui:SymbolIcon ArrowShuffle24}" />
                        <ui:Button
                            Margin="0,0,8,8"
                            Click="DefaultPort_Click"
                            Content="{l:T '恢复默认 22'}"
                            Icon="{ui:SymbolIcon ArrowReset24}" />
                        <ui:ProgressRing
                            x:Name="PortBusy"
                            Width="18"
                            Height="18"
                            Margin="4,0,0,8"
                            IsIndeterminate="True"
                            Visibility="Collapsed" />
                    </WrapPanel>
                    <TextBlock x:Name="ConfigPathText" Style="{StaticResource CardDesc}" />
                </StackPanel>
            </ui:CardExpander>

            <TextBlock Style="{StaticResource SectionHeader}" Text="{l:T '连接命令'}" />
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Code24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock
                            x:Name="CommandText"
                            FontFamily="Consolas, Cascadia Mono"
                            FontSize="14"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="ssh user@192.168.1.2" />
                        <TextBlock Style="{StaticResource CardDesc}" Text="{l:T '密码为这台电脑的 Windows 账户密码；管理员账户的公钥请放在 C:\\ProgramData\\ssh\\administrators_authorized_keys'}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button
                    Click="CopyCmd_Click"
                    Content="{l:T '复制命令'}"
                    Icon="{ui:SymbolIcon Copy24}" />
            </ui:CardControl>
        </StackPanel>
    </ScrollViewer>
</Page>
