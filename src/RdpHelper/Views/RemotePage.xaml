<Page
    x:Class="RdpHelper.Views.RemotePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:l="clr-namespace:RdpHelper.Localization"
    Title="{l:T '远程桌面'}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,4,40,40" MaxWidth="1000">
            <TextBlock Style="{StaticResource PageTitle}" Text="{l:T '远程桌面'}" />

            <ui:InfoBar
                x:Name="EditionBar"
                Title="{l:T '当前系统不支持作为远程桌面主机'}"
                Margin="0,0,0,12"
                IsClosable="False"
                IsOpen="False"
                Severity="Warning" />
            <ui:CardExpander
                x:Name="UpgradeCard"
                Margin="0,0,0,12"
                Icon="{ui:SymbolIcon ArrowCircleUp24}"
                IsExpanded="True"
                Visibility="Collapsed">
                <ui:CardExpander.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T '升级到 Windows 专业版'}" />
                        <TextBlock Style="{StaticResource CardDesc}" Text="{l:T '专业版自带远程桌面服务。就地升级，不重装系统、保留文件和软件，完成后自动重启。需要正版专业版许可。'}" />
                    </StackPanel>
                </ui:CardExpander.Header>
                <StackPanel Margin="40,4,0,4">
                    <WrapPanel>
                        <ui:Button
                            Margin="0,0,8,8"
                            Appearance="Primary"
                            Click="UpgradeStore_Click"
                            Content="{l:T '在微软商店购买升级'}"
                            Icon="{ui:SymbolIcon Cart24}" />
                        <ui:Button
                            Margin="0,0,8,8"
                            Click="UpgradeActivation_Click"
                            Content="{l:T '打开系统激活设置'}"
                            Icon="{ui:SymbolIcon Key24}" />
                    </WrapPanel>
                    <TextBlock
                        Margin="0,8,0,0"
                        Style="{StaticResource CardTitle}"
                        Text="{l:T '已有专业版产品密钥'}" />
                    <WrapPanel Margin="0,6,0,0">
                        <ui:TextBox
                            x:Name="UpgradeKeyBox"
                            Width="340"
                            Margin="0,0,8,8"
                            FontFamily="Consolas, Cascadia Mono"
                            PlaceholderText="XXXXX-XXXXX-XXXXX-XXXXX-XXXXX" />
                        <ui:Button
                            x:Name="UpgradeKeyButton"
                            Margin="0,0,8,8"
                            Click="UpgradeKey_Click"
                            Content="{l:T '用此密钥升级'}"
                            Icon="{ui:SymbolIcon ArrowCircleUp24}" />
                        <ui:ProgressRing
                            x:Name="UpgradeBusy"
                            Width="18"
                            Height="18"
                            Margin="4,0,0,8"
                            IsIndeterminate="True"
                            Visibility="Collapsed" />
                    </WrapPanel>
                    <TextBlock
                        Margin="0,8,0,0"
                        Style="{StaticResource CardTitle}"
                        Text="{l:T '这台电脑以前激活过专业版？'}" />
                    <TextBlock Style="{StaticResource CardDesc}" Text="{l:T '数字许可证绑定在硬件或微软账户上时，可用微软公开的专业版通用密钥切换版本，重启联网后自动激活；没有专业版许可则会处于未激活状态。'}" />
                    <WrapPanel Margin="0,6,0,0">
                        <ui:Button
                            x:Name="UpgradeGenericButton"
                            Margin="0,0,8,8"
                            Click="UpgradeGeneric_Click"
                            Content="{l:T '用通用密钥切换到专业版'}"
                            Icon="{ui:SymbolIcon ArrowSwap24}" />
                    </WrapPanel>
                </StackPanel>
            </ui:CardExpander>
            <ui:InfoBar
                x:Name="RemoteSessionBar"
                Title="{l:T '你正在通过远程桌面使用这台电脑'}"
                Margin="0,0,0,12"
                IsClosable="True"
                IsOpen="False"
                Message="{l:T '修改端口或关闭远程桌面会立即断开当前连接，请确认能用新端口重新连回来。'}"
                Severity="Informational" />

            <ui:InfoBar
                x:Name="PasswordBar"
                Margin="0,0,0,4"
                IsClosable="False"
                IsOpen="False"
                Severity="Warning" />
            <ui:Button
                x:Name="PasswordFixButton"
                Margin="0,0,0,12"
                Appearance="Primary"
                Click="GoAccounts_Click"
                Content="{l:T '去「账户与密码」处理'}"
                Icon="{ui:SymbolIcon Person24}"
                Visibility="Collapsed" />
            <!--  顶部：电脑卡片（仿 Win11 设置）  -->
            <Border
                Padding="20"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image
                        Width="72"
                        Height="72"
                        Margin="0,0,20,0"
                        Source="pack://application:,,,/Assets/app.png" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock
                            x:Name="MachineText"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="DESKTOP" />
                        <TextBlock x:Name="OsText" Style="{StaticResource CardDesc}" Text="Windows" />
                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                            <Ellipse
                                x:Name="StatusDot"
                                Width="8"
                                Height="8"
                                Margin="0,0,8,0"
                                Fill="Gray" />
                            <TextBlock
                                x:Name="StatusText"
                                FontSize="13"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{l:T '正在读取状态…'}" />
                        </StackPanel>
                    </StackPanel>
                    <ui:Button
                        x:Name="CopyButton"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Appearance="Primary"
                        Click="Copy_Click"
                        Content="{l:T '一键复制远程信息'}"
                        Icon="{ui:SymbolIcon Copy24}" />
                </Grid>
            </Border>

            <TextBlock Style="{StaticResource SectionHeader}" Text="{l:T '连接'}" />

            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Desktop24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T '远程桌面'}" />
                        <TextBlock Style="{StaticResource CardDesc}" Text="{l:T '允许其他设备通过远程桌面应用 (mstsc) 连接并控制这台电脑'}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:ProgressRing
                        x:Name="RdpBusy"
                        Width="18"
                        Height="18"
                        Margin="0,0,12,0"
                        IsIndeterminate="True"
                        Visibility="Collapsed" />
                    <ui:ToggleSwitch
                        x:Name="RdpToggle"
                        Click="RdpToggle_Click"
                        OffContent="{l:T '关'}"
                        OnContent="{l:T '开'}" />
                </StackPanel>
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon ShieldCheckmark24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T '要求设备使用网络级别身份验证 (NLA) 进行连接'}" />
                        <TextBlock Style="{StaticResource CardDesc}" Text="{l:T '连接前先验证账户密码，更安全，推荐保持开启；旧版客户端连不上时可临时关闭'}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch
                    x:Name="NlaToggle"
                    Click="NlaToggle_Click"
                    OffContent="{l:T '关'}"
                    OnContent="{l:T '开'}" />
            </ui:CardControl>

            <ui:CardExpander Margin="0,0,0,4" Icon="{ui:SymbolIcon NumberSymbol24}" IsExpanded="True">
                <ui:CardExpander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="{l:T '远程桌面端口'}" />
                            <TextBlock Style="{StaticResource CardDesc}" Text="{l:T '默认 3389；改成不常见的端口可减少公网扫描和暴力破解'}" />
                        </StackPanel>
                        <TextBlock
                            x:Name="PortText"
                            Grid.Column="1"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="3389" />
                    </Grid>
                </ui:CardExpander.Header>
                <StackPanel Margin="40,4,0,4">
                    <WrapPanel>
                        <ui:TextBox
                            x:Name="PortBox"
                            Width="160"
                            Margin="0,0,8,8"
                            MaxLength="5"
                            PlaceholderText="1024-65535" />
                        <ui:Button
                            Margin="0,0,8,8"
                            Appearance="Primary"
                            Click="ApplyPort_Click"
                            Content="{l:T '应用新端口'}"
                            Icon="{ui:SymbolIcon Checkmark24}" />
                        <ui:Button
                            Margin="0,0,8,8"
                            Click="RandomPort_Click"
                            Content="{l:T '随机生成'}"
                            Icon="{ui:SymbolIcon ArrowShuffle24}" />
                        <ui:Button
                            Margin="0,0,8,8"
                            Click="DefaultPort_Click"
                            Content="{l:T '恢复默认 3389'}"
                            Icon="{ui:SymbolIcon ArrowReset24}" />
                        <ui:ProgressRing
                            x:Name="PortBusy"
                            Width="18"
                            Height="18"
                            Margin="4,0,0,8"
                            IsIndeterminate="True"
                            Visibility="Collapsed" />
                    </WrapPanel>
                    <TextBlock
                        Style="{StaticResource CardDesc}"
                        Text="{l:T '应用后会自动：写入注册表 PortNumber → 更新防火墙放行规则（TCP+UDP）→ 重启远程桌面服务。重启时已连接的远程会话会断开，用新端口重连即可（地址写成 IP:端口）。'}" />
                </StackPanel>
            </ui:CardExpander>

            <TextBlock Style="{StaticResource SectionHeader}" Text="{l:T '本机局域网地址'}" />
            <ItemsControl x:Name="LanList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Router24}">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            FontFamily="Consolas, Cascadia Mono, Segoe UI"
                                            FontSize="15"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Text="{Binding Ip}" />
                                        <Border Style="{StaticResource Badge}" Visibility="{Binding ShowBadge, Converter={StaticResource BoolToVis}}">
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{Binding Badge}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource CardDesc}">
                                        <Run Text="{Binding Kind, Mode=OneWay}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding Adapter, Mode=OneWay}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding Description, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:Button
                                Click="CopyIp_Click"
                                Content="{l:T '复制地址'}"
                                Icon="{ui:SymbolIcon Copy24}"
                                Tag="{Binding Ip}" />
                        </ui:CardControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock
                x:Name="NoLanText"
                Style="{StaticResource CardDesc}"
                Text="{l:T '没有检测到可用的局域网 IPv4 地址，请检查网络连接。'}"
                Visibility="Collapsed" />

            <TextBlock Style="{StaticResource SectionHeader}" Text="{l:T '将要复制的内容'}" />
            <ui:TextBox
                x:Name="PreviewBox"
                MinHeight="120"
                FontFamily="Consolas, Cascadia Mono, Microsoft YaHei UI"
                FontSize="12"
                IsReadOnly="True"
                TextWrapping="Wrap" />
            <WrapPanel Margin="0,8,0,0">
                <ui:Button
                    Margin="0,0,8,0"
                    Click="Refresh_Click"
                    Content="{l:T '刷新'}"
                    Icon="{ui:SymbolIcon ArrowClockwise24}" />
                <ui:Button
                    Click="OpenSysSettings_Click"
                    Content="{l:T '打开系统远程桌面设置'}"
                    Icon="{ui:SymbolIcon Open24}" />
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
