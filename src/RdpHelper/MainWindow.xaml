<ui:FluentWindow
    x:Class="RdpHelper.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:l="clr-namespace:RdpHelper.Localization"
    xmlns:views="clr-namespace:RdpHelper.Views"
    Title="{l:T 'RdpHelper 远程桌面助手'}"
    Width="1080"
    Height="760"
    MinWidth="780"
    MinHeight="560"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Acrylic"
    WindowCornerPreference="Round"
    WindowStartupLocation="Manual"
    Icon="pack://application:,,,/Assets/app.png"
    UseLayoutRounding="True"
    TextOptions.TextHintingMode="Fixed">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            x:Name="AppTitleBar"
            Grid.Row="0"
            Title="{l:T 'RdpHelper 远程桌面助手'}"
            Icon="{ui:ImageIcon 'pack://application:,,,/Assets/app.png'}" />

        <ui:NavigationView
            x:Name="RootNavigation"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleVisible="True"
            OpenPaneLength="232"
            PaneDisplayMode="Left"
            Transition="None">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem
                    Content="{l:T '远程桌面'}"
                    Icon="{ui:SymbolIcon Desktop24}"
                    NavigationCacheMode="Enabled"
                    TargetPageType="{x:Type views:RemotePage}" />
                <ui:NavigationViewItem
                    Content="SSH"
                    Icon="{ui:SymbolIcon WindowConsole20}"
                    NavigationCacheMode="Enabled"
                    TargetPageType="{x:Type views:SshPage}" />
                <ui:NavigationViewItem
                    Content="{l:T '访问控制'}"
                    Icon="{ui:SymbolIcon ShieldKeyhole24}"
                    NavigationCacheMode="Enabled"
                    TargetPageType="{x:Type views:AccessPage}" />
                <ui:NavigationViewItem
                    Content="{l:T '账户与密码'}"
                    Icon="{ui:SymbolIcon Person24}"
                    NavigationCacheMode="Enabled"
                    TargetPageType="{x:Type views:AccountsPage}" />
                <ui:NavigationViewItem
                    Content="{l:T '内网穿透'}"
                    Icon="{ui:SymbolIcon Globe24}"
                    NavigationCacheMode="Enabled"
                    TargetPageType="{x:Type views:TunnelPage}" />
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem
                    Content="{l:T '设置'}"
                    Icon="{ui:SymbolIcon Settings24}"
                    NavigationCacheMode="Enabled"
                    TargetPageType="{x:Type views:SettingsPage}" />
                <ui:NavigationViewItem
                    Content="{l:T '关于'}"
                    Icon="{ui:SymbolIcon Info24}"
                    NavigationCacheMode="Enabled"
                    TargetPageType="{x:Type views:AboutPage}" />
            </ui:NavigationView.FooterMenuItems>
            <ui:NavigationView.ContentOverlay>
                <Grid>
                    <ui:SnackbarPresenter x:Name="SnackbarPresenter" />
                </Grid>
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
